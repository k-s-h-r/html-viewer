{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Main Process (Dev)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": ["dist-electron/main/index.js"],
      "env": {
        "VITE_DEV_SERVER_URL": "http://127.0.0.1:5173"
      },
      "outputCapture": "std",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist-electron/**/*.js"],
      "preLaunchTask": "dev:debug-prep"
    },
    {
      "name": "Debug Main Process (Built)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": ["dist-electron/main/index.js"],
      "outputCapture": "std",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist-electron/**/*.js"],
      "preLaunchTask": "build:app"
    }
  ]
}
