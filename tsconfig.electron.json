{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist-electron",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node", "electron"]
  },
  "include": ["src/main", "src/shared"],
  "exclude": ["**/*.test.ts", "src/preload/**"]
}
