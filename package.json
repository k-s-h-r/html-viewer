{
  "name": "specdeck",
  "description": "PPT-like viewer and editor for HTML specifications",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\" \"npm:dev:electron-start\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "concurrently -k \"tsc -w -p tsconfig.electron.json\" \"tsc -w -p tsconfig.preload.json\"",
    "dev:electron-start": "node scripts/ensure-electron.mjs && wait-on tcp:5173 dist-electron/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main/index.js",
    "prestart": "npm run build",
    "start": "electron-forge start",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json",
    "dist": "npm run make",
    "dist:dir": "npm run package",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.preload.json",
    "lint": "eslint .",
    "postinstall": "node scripts/ensure-electron.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:smoke": "npm run build && node scripts/ensure-electron.mjs && node scripts/smoke-app.mjs",
    "test:e2e": "npm run build && playwright test",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@svgedit/svgcanvas": "^7.4.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.11.2",
    "shadcn": "^4.10.0",
    "sirv": "^3.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
  }
}
